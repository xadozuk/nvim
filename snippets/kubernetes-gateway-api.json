{
  "k8s-gateway-httproute": {
    "prefix": "k-gw-httproute",
    "description": "Gateway API HTTPRoute",
    "body": [
      "# yaml-language-server: \\$schema=https://raw.githubusercontent.com/datreeio/CRDs-catalog/main/gateway.networking.k8s.io/httproute_v1.json",
      "apiVersion: gateway.networking.k8s.io/v1",
      "kind: HTTPRoute",
      "metadata:",
      "  name: ${1:name}",
      "  namespace: ${2:namespace}",
      "spec:",
      "  parentRefs:",
      "    - name: ${3:gateway}",
      "      namespace: ${4:gateway-namespace}",
      "      sectionName: ${5:https}",
      "  hostnames:",
      "    - ${6:app.example.com}",
      "  rules:",
      "    - matches:",
      "        - path:",
      "            type: ${7:PathPrefix}",
      "            value: ${8:/}",
      "      backendRefs:",
      "        - name: ${9:service}",
      "          port: ${10:80}",
      "$0"
    ]
  }
}
